# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Only needed in webhook mode (production)
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
# polling (local dev) | webhook (production)
BOT_MODE=polling
PORT=3000
# Secret the external scheduler (cron-job.org) sends to /cron/daily
CRON_SECRET=

# --- Database ---
DATABASE_URL=postgresql://localhost:5432/catchup_bot

# --- AI providers (milestone 3) ---
LLM_PROVIDER=groq            # groq | gemini
GROQ_API_KEY=
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Behaviour ---
SUMMARY_TIME=19:00
DEFAULT_TIMEZONE=Africa/Lagos
NO_DUE_DATE_DAYS=7
RAW_MESSAGE_RETENTION_DAYS=30
EXTRACTION_BATCH_SIZE=20

# --- Ops ---
SENTRY_DSN=
BOT_OWNER_TELEGRAM_ID=
# Kill switch: pauses all AI calls and summaries
BOT_PAUSED=false
LOG_LEVEL=info
